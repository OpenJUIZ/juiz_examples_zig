.{
    // juiz の Zig 版サンプル。zigjuiz (juiz の Zig 向けライブラリ) を使う
    .name = .juiz_examples_zig,
    .version = "0.1.0",
    .fingerprint = 0xc3020a70102e69ba,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // zigjuiz (juiz の Releases のアーカイブ)。juiz の版を変えるときは
        //   zig fetch --save=zigjuiz https://github.com/OpenJUIZ/juiz/releases/download/v<版>/zigjuiz-<版>.tar.gz
        // で書き換える (build.sh の JUIZ_GIT_REF と同じ版にする)
        .zigjuiz = .{
            .url = "https://github.com/OpenJUIZ/juiz/releases/download/v0.4.0/zigjuiz-0.4.0.tar.gz",
            .hash = "zigjuiz-0.4.0-SU50lF3KAgAzE7olPLxENHsVhvttxWicOOEXPUzUkLFr",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "process",
        "container",
        "component",
        "types",
    },
}
